# name: test/sql/read_lines_shellfs.test
# description: Test read_lines / read_lines_lateral with non-seekable sources (shellfs pipes)
# group: [sql]

require read_lines

require shellfs

# =============================================================================
# read_lines with shellfs pipes (memory-bounded streaming reader)
# =============================================================================

# Basic pipe read
query II
SELECT line_number, rtrim(content, chr(10) || chr(13))
FROM read_lines('printf "line1\nline2\nline3" |');
----
1	line1
2	line2
3	line3

# Pipe with line selection (forward-only, no from-end)
query II
SELECT line_number, rtrim(content, chr(10) || chr(13))
FROM read_lines('printf "a\nb\nc\nd\ne" |', '2-4');
----
2	b
3	c
4	d

# Single line selection from pipe
query II
SELECT line_number, rtrim(content, chr(10) || chr(13))
FROM read_lines('printf "first\nsecond\nthird" |', 2);
----
2	second

# Byte offsets are tracked arithmetically by the streaming reader for pipes
query III
SELECT line_number, rtrim(content, chr(10) || chr(13)), byte_offset
FROM read_lines('printf "aa\nbb\ncc" |');
----
1	aa	0
2	bb	3
3	cc	6

# Regression: a BLANK line in the middle of a pipe must NOT be misread as EOF.
# Streaming EOF is a 0-byte read, so the empty line 2 is preserved and line 3
# is still produced.
query II
SELECT line_number, rtrim(content, chr(10) || chr(13))
FROM read_lines('printf "a\n\nc" |');
----
1	a
2	(empty)
3	c

# =============================================================================
# read_lines_lateral with non-seekable source (now SUPPORTED via streaming)
# =============================================================================

# Lateral over a single pipe should produce all 3 rows (previously errored)
query II
SELECT l.line_number, rtrim(l.content, chr(10) || chr(13))
FROM (VALUES ('printf "x\ny\nz" |')) AS v(cmd),
     read_lines_lateral(v.cmd) AS l
ORDER BY l.line_number;
----
1	x
2	y
3	z

# Regression: blank line in the middle of a pipe through the lateral reader
query II
SELECT l.line_number, rtrim(l.content, chr(10) || chr(13))
FROM (VALUES ('printf "a\n\nc" |')) AS v(cmd),
     read_lines_lateral(v.cmd) AS l
ORDER BY l.line_number;
----
1	a
2	(empty)
3	c

# Correlated multi-row: each input row runs its OWN command and gets its own
# streaming reader. Different printf commands, different line counts.
query III
SELECT v.id, l.line_number, rtrim(l.content, chr(10) || chr(13))
FROM (VALUES
        (1, 'printf "one\ntwo" |'),
        (2, 'printf "alpha\nbeta\ngamma" |'),
        (3, 'printf "solo" |')
     ) AS v(id, cmd),
     read_lines_lateral(v.cmd) AS l
ORDER BY v.id, l.line_number;
----
1	1	one
1	2	two
2	1	alpha
2	2	beta
2	3	gamma
3	1	solo

# Correlated multi-row count: verify per-row line counts independently
query II
SELECT v.id, count(*) AS n
FROM (VALUES
        (1, 'printf "a\nb\nc\nd" |'),
        (2, 'printf "x" |')
     ) AS v(id, cmd),
     read_lines_lateral(v.cmd) AS l
GROUP BY v.id
ORDER BY v.id;
----
1	4
2	1

# Forward line selection through the lateral streaming reader
query II
SELECT l.line_number, rtrim(l.content, chr(10) || chr(13))
FROM (VALUES ('printf "l1\nl2\nl3\nl4\nl5" |')) AS v(cmd),
     read_lines_lateral(v.cmd, '2-4') AS l
ORDER BY l.line_number;
----
2	l2
3	l3
4	l4

# =============================================================================
# From-end selection on non-seekable source (still an error: cannot resolve
# +N from the end of a pure stream without buffering everything)
# =============================================================================

statement error
SELECT * FROM read_lines('printf "a\nb\nc" |', '+2');
----
from-end line selection requires a seekable source

statement error
SELECT l.*
FROM (VALUES ('printf "a\nb\nc" |')) AS v(cmd),
     read_lines_lateral(v.cmd, '+2') AS l;
----
from-end line selection requires a seekable source

# =============================================================================
# Regression: seekable file sources still work exactly as before
# =============================================================================

# Normal file read
query II
SELECT line_number, rtrim(content, chr(10) || chr(13))
FROM read_lines('test/data/simple.txt');
----
1	line one
2	line two
3	line three
4	line four
5	line five

# File with line selection
query II
SELECT line_number, rtrim(content, chr(10) || chr(13))
FROM read_lines('test/data/simple.txt', '2-4');
----
2	line two
3	line three
4	line four

# File with from-end selection (seekable, should work)
query II
SELECT line_number, rtrim(content, chr(10) || chr(13))
FROM read_lines('test/data/simple.txt', '+2');
----
4	line four

# Lateral with normal file (seekable, should work)
query III
SELECT v.path, l.line_number, rtrim(l.content, chr(10) || chr(13))
FROM (VALUES ('test/data/single_line.txt')) AS v(path),
     read_lines_lateral(v.path) AS l;
----
test/data/single_line.txt	1	only one line

# Lateral with multiple seekable files
query II
SELECT v.path LIKE '%log1%' AS is_log1, count(*)
FROM (VALUES ('test/data/log1.txt'), ('test/data/log2.txt')) AS v(path),
     read_lines_lateral(v.path) AS l
GROUP BY v.path
ORDER BY v.path;
----
true	5
false	3
